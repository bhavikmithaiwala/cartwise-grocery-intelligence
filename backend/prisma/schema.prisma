generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

model AppMetadata {
  id String @id
  currency String @default("CAD")
  schemaVersion Int @default(1)
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  retainImages Boolean @default(false)
  createdAt DateTime @default(now())
  sessions Session[]
  receipts Receipt[]
  products CanonicalProduct[]
  observations PriceObservation[]
  budgets MonthlyBudget[]
}

model Session {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model Receipt {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawMerchant String @default("")
  purchaseDate String @default("")
  currency String @default("CAD")
  status String @default("needs_review")
  subtotalCents Int @default(0)
  taxCents Int @default(0)
  totalCents Int @default(0)
  fileSha256 String?
  imagePath String?
  suggestions String @default("{}")
  correctionNote String @default("")
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lines ReceiptLine[]
  job OcrJob?
  observations PriceObservation[]
  @@index([userId, purchaseDate, status])
  @@index([userId, fileSha256])
}

model ReceiptLine {
  id String @id @default(cuid())
  receiptId String
  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  rawText String @default("")
  description String
  category String @default("Other")
  quantityDecimal String @default("1")
  quantityUnit String @default("each")
  packageSizeDecimal String?
  packageUnit String?
  lineTotalCents Int
  parserConfidence Float?
  reviewedByUser Boolean @default(false)
  productId String?
  product CanonicalProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  observation PriceObservation?
  @@index([receiptId])
}

model CanonicalProduct {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  unitFamily String
  lines ReceiptLine[]
  observations PriceObservation[]
  @@unique([userId, name, unitFamily])
}

model OcrJob {
  id String @id @default(cuid())
  receiptId String @unique
  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  status String @default("queued")
  attemptCount Int @default(0)
  startedAt DateTime?
  finishedAt DateTime?
  safeErrorCode String?
}

model PriceObservation {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiptId String
  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  lineId String @unique
  line ReceiptLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  productId String
  product CanonicalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseDate String
  merchant String
  normalizedQuantityDecimal String
  normalizedUnit String
  lineTotalCents Int
  @@index([userId, productId, purchaseDate])
}

model MonthlyBudget {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String
  month String
  limitCents Int
  @@unique([userId, category, month])
}
